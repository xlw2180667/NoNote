          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모두 이 기기에 저장되었습니다. 나머지는 알아서 iCloud로 올라갑니다 — 나중에 앱을 다시 열어 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
