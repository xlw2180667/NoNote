    "#appLockDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Require Face ID, Touch ID, or passcode to open NoDiary."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide Face ID, Touch ID o código para abrir NoDiary."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NoDiary を開くときに Face ID・Touch ID・パスコードを求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NoDiary를 열 때 Face ID, Touch ID 또는 암호를 요구합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
