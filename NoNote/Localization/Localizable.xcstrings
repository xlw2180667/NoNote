          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有內容都已儲存在這台裝置上。剩下的會自己傳到 iCloud——稍後再打開一次 app 就好。"
          }
        }
      }
